# PostgreSQL — defaults match `npm run db:up` (compose Postgres on host port 4002)
DB_HOST=localhost
DB_PORT=4002
DB_DATABASE=study_physic_by_test
DB_USERNAME=study_physic_by_test
DB_PASSWORD=study_physic_by_test

# Auth — generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=change-me-to-another-long-random-secret
REFRESH_TOKEN_EXPIRES_IN=2d
SALT_ROUND=10

# App
PORT=3000
APP_NAME=iLrn
NODE_ENV=development
